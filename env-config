#!/usr/bin/env bash

set -euo pipefail

shopt -s dotglob # We want glob to match hidden files too
shopt -s nullglob # We want glob to return nothing of there is no match
shopt -s sourcepath # We want source to search for files in PATH

function ec_root_dir {
    # From https://stackoverflow.com/a/246128
    local SOURCE_PATH="${BASH_SOURCE[0]}"
    local SYMLINK_DIR
    while [ -L "$SOURCE_PATH" ]; do
        SYMLINK_DIR="$( cd -P "$( dirname "$SOURCE_PATH" )" >/dev/null 2>&1 && pwd )"
        SOURCE_PATH="$(readlink "$SOURCE_PATH")"
        if [[ $SOURCE_PATH != /* ]]; then
            SOURCE_PATH=$SYMLINK_DIR/$SOURCE_PATH
        fi
    done
    (cd -P "$( dirname "$SOURCE_PATH" )" >/dev/null 2>&1 && pwd)
}

function ec_contains {
    local pattern="$1"
    shift
    for i in "$@"; do
        if [[ "$i" == "$pattern" ]]; then
            return 0
        fi
    done
    return 1
}

# Global variables
# Declared upfront for better linting in the functions below
# Some of them are marked readonly later-on after their proper initialization

EC_PROXY_SERVER=""
EC_PROXY_PORT=""
EC_PROXY_USER=""
EC_NO_PROXY=""

EC_POSITIONAL_ARGS=()

EC_ENABLED_LAYERS=()


EC_ROOT_DIR="$(ec_root_dir)"
readonly EC_ROOT_DIR
readonly EC_LAYER_CORE_DIR="$EC_ROOT_DIR/layer-core"
readonly EC_BUILD_DIR="$EC_ROOT_DIR/build"
readonly EC_LIB_DIR="$EC_ROOT_DIR/lib"

export PATH="$EC_ROOT_DIR:$PATH"

EC_ENABLED_LAYERS=("$EC_LAYER_CORE_DIR")

source "lib/ansi.bash"
source "lib/log.bash"

ec_log_plain "Displaying all variants of log levels:"
ec_log_debug "- this is a debug message"
ec_log_note  "- this is a note"
ec_log_warn  "- this is a warning"
ec_log_error "- this is an error"

function ec_into_layer_path {
    # Make a path relative to the englobing layer. Return 1 if not in an enabled layer.
    # The path printed into stdout as the form //<layer-name>/<subpath>
    local path="$1"
    for layer_path in "${EC_ENABLED_LAYERS[@]}"; do
        if [[ "$path" == "$layer_path"/* ]]; then
            local parent_dir
            parent_dir="$(dirname "$layer_path")"
            local subpath="${path#"^$parent_dir"}"
            echo "/$subpath"
            return 0
        fi
    done
    ec_log_error "Path \`$path\` is not in an enabled layer."
    return 1
}

function ec_validate_layers {
    local invalid_layer=false
    for layer_dir in "$@"; do
        if [[ ! -d "$layer_dir" ]]; then
            ec_log_error "Layer directory \`$layer_dir\` does not exist."
            invalid_layer=true
        elif [[ ! -f "$layer_dir/layer.bash" ]]; then
            ec_log_error "Layer file \`$layer_dir/layer.bash\` does not exist."
            invalid_layer=true
        fi
    done
    if $invalid_layer; then
        return 1
    fi
}

function ec_source_and_validate_distro {
    local valid=false
    for layer_path in "${EC_ENABLED_LAYERS[@]}"; do
        local distro_file="$layer_path/distros/$EC_DISTRO.bash"
        ec_log_debug "Checking distro file $distro_file"
        if [[ -f $distro_file ]]; then
            # shellcheck disable=SC1090
            source "$distro_file" || valid=false
            # TODO add validation
            valid=true
        fi
    done
    if ! $valid; then
        ec_log_error "Unsupported distro \`$EC_DISTRO\`"
        return 1
    fi
}

function ec_source_and_validate_platform {
    local valid=false
    for layer_path in "${EC_ENABLED_LAYERS[@]}"; do
        local platform_file="$layer_path/platforms/$EC_PLATFORM.bash"
        ec_log_debug "Checking platform file $platform_file"
        if [[ -f $platform_file ]]; then
            # shellcheck disable=SC1090
            source "$platform_file" || valid=false
            # TODO add validation
            valid=true
        fi
    done
    if ! $valid; then
        ec_log_error "Unsupported platform \`$EC_PLATFORM\`"
        return 1
    fi
}

function ec_help {
    cat << 'EOH'
Usage:
    env-config [OPTIONS] COMMAND

Commands:
    install [PKG...]        Install and configure packages
    remove  [PKG...]        Completely uninstall packages (package itself and its configuration)
    diff    [PKG...]        List the diffs between the deployed config files and ones in the repo
    backup  [PKG...]        Copy the deployed files back into the repo

Options:
    -h, --help              Display this message
    -l, --layer             Path to a layer root directory (can be repeated, layer-core is always included)
    --proxy-server=URL      Proxy server URL
    --proxy-port=PORT       Proxy port number (requires --proxy-server)
    --proxy-user=USER       Proxy user (requires --proxy-server)
    --no-proxy=URL,...      URLs not served by the proxy (requires --proxy-server)

The arguments `PKG` must be the basename of one of the recipes available across all the layers
(ie. the recipe file `layer-core/recipes/shell/zsh.sh` provides the package `zsh`).

If `all` is provided as package env-config will install and configure all applicable packages
for the current distribution and platform.

If no package is provided `all` is used as default.
EOH
}

function ec_print_context {
    ec_log_debug "################################################################################"
    ec_log_debug "### Context"
    ec_log_debug "################################################################################"
    ec_log_debug "EC_ROOT_DIR=\`$EC_ROOT_DIR\`"
    ec_log_debug "EC_LAYER_CORE_DIR=\`$EC_LAYER_CORE_DIR\`"
    ec_log_debug "EC_BUILD_DIR=\`$EC_BUILD_DIR\`"
    ec_log_debug "EC_LIB_DIR=\`$EC_LIB_DIR\`"
}

function ec_print_cli_args {
    ec_log_debug "################################################################################"
    ec_log_debug "### CLI arguments"
    ec_log_debug "################################################################################"
    ec_log_debug "EC_ENABLED_LAYERS=(${EC_ENABLED_LAYERS[*]})"
    ec_log_debug "EC_PROXY_SERVER=$EC_PROXY_SERVER"
    ec_log_debug "EC_PROXY_PORT=$EC_PROXY_PORT"
    ec_log_debug "EC_PROXY_USER=$EC_PROXY_USER"
    ec_log_debug "EC_NO_PROXY=$EC_NO_PROXY"
    ec_log_debug "EC_POSITIONAL_ARGS=(${EC_POSITIONAL_ARGS[*]})"
}

function ec_source_distro_and_platform {
    local valid=true
    ec_source_and_validate_distro || valid=false
    ec_source_and_validate_platform || valid=false
    $valid
}

function ec_get_recipe_file_for_package {
    local package="$1"
    local recipe_file=()
    for layer_path in "${EC_ENABLED_LAYERS[@]}"; do
        shopt -s nullglob
        recipe_file+=("$layer_path"/recipes/*/"$package".bash)
    done
    if (( ${#recipe_file[@]} > 1 )); then
        ec_log_error "Found more than one recipe for package \`$package\` (total ${#recipe_file[@]}):"
        ec_log_error "${recipe_file[@]}"
        return 1
    elif (( ${#recipe_file[@]} == 0 )); then
        ec_log_error "No recipe found for package \`$package\`."
        return 1
    fi
    echo "${recipe_file[@]}"
}

while (( $# > 0 )); do
    case $1 in
        -h|--help)
            ec_help; exit 0;;
        -l|--layer)
            EC_ENABLED_LAYERS+=("$2"); shift 2;;
        --proxy-server)
            EC_PROXY_SERVER="$2"; shift 2;;
        --proxy-port)
            EC_PROXY_PORT="$2"; shift 2;;
        --proxy-user)
            EC_PROXY_USER="$2"; shift 2;;
        --no-proxy)
            EC_NO_PROXY="$2"; shift 2;;
        -*)
            echo "Error: unknown option \`$1\`"; exit 1;;
        *)
            EC_POSITIONAL_ARGS+=("$1"); shift;;
    esac
done

readonly EC_PROXY_SERVER
readonly EC_PROXY_PORT
readonly EC_PROXY_USER
readonly EC_NO_PROXY
readonly EC_POSITIONAL_ARGS
readonly EC_ENABLED_LAYERS

readonly EC_COMMAND="${EC_POSITIONAL_ARGS[0]:-}"
EC_TARGET_PACKAGES=("${EC_POSITIONAL_ARGS[@]:1}")
declare -A EC_PACKAGES_DEPENDS=()
declare -A EC_PACKAGES_HIGHEST_DEPEND_RANK=()
declare -a all=()

function ec_source_recipes_recursively {
    # Source all packages from the global EC_TARGET_PACKAGES and all their
    # dependencies recursively and populate the global EC_PACKAGES_DEPENDS
    local recipe_file
    declare -a depends
    for package in "${EC_TARGET_PACKAGES[@]}"; do
        if ! ec_contains "$package" "${!EC_PACKAGES_DEPENDS[@]}"; then
            depends=()
            recipe_file=$(ec_get_recipe_file_for_package "$package")
            # shellcheck disable=SC1090
            source "$recipe_file"
            echo "Adding $package with depends \`${depends[*]}\`"
            EC_PACKAGES_DEPENDS[$package]="${depends[*]}"
            ec_source_recipes_recursively "${depends[@]}"
        fi
    done
}

function ec_max {
    # Return the maximum value between two arguments
    local a=$1
    local b=$2
    echo $(( a > b ? a : b ))
    return 0
}

function ec_highest_depend_rank_for_package {
    local package="$1"
    local highest_rank=0
    local depend_rank
    local package_depends
    # Split the DEPENDS string into an array
    eval "package_depends=(${EC_PACKAGES_DEPENDS[$package]})"
    for depend in "${package_depends[@]}"; do
        if [[ ! -v EC_PACKAGES_HIGHEST_DEPEND_RANK[$depend] ]]; then
            # The rank of one of the package dependencies is unknown,
            # cannot get highest rank for this package yet
            return 1
        fi
        depend_rank="${EC_PACKAGES_HIGHEST_DEPEND_RANK[$depend]}"
        highest_rank=$(ec_max "$highest_rank" "$depend_rank")
    done
    echo "$highest_rank"
}

function ec_compute_dependency_chain {
    local package
    local rank
    local package_queue=("${!EC_PACKAGES_DEPENDS[@]}")
    local it=0
    while (( ${#package_queue[@]} )); do
        ((++it))
        # TODO detect if we iterated over all items and make no progress instead
        if (( it > 100 )); then
            ec_log_error "Infinite loop detected, aborting."
            exit 1
        fi
        # pop the first package from the queue
        package="${package_queue[0]}"
        package_queue=("${package_queue[@]:1}")
        if rank=$(ec_highest_depend_rank_for_package "$package"); then
            EC_PACKAGES_HIGHEST_DEPEND_RANK[$package]="$((rank+1))"
        else
            # push back the package into the queue as rank cannot be known yet
            package_queue+=("$package")
        fi
    done
}

function ec_do_install {
    # Iterate over all packages ranks and do the installation of all packages
    # of rank 1, then rank 2, etc
    # TODO make a visitor taking the callback as argument
    local rank=1
    local packages_rank_decl
    packages_rank_decl="$(declare -p EC_PACKAGES_HIGHEST_DEPEND_RANK)"
    declare -A packages_rank="${packages_rank_decl#*=}"
    while (( ${#packages_rank[@]} )); do
        for package in "${!packages_rank[@]}"; do
            if (( packages_rank[$package] == rank )); then
                echo "Installing \`$package\`"
                unset "packages_rank[$package]"
            fi
        done
        ((++rank))
    done

}

function ec_do_remove {
    echo "Removing \`${EC_PACKAGES[*]}\`"
}

function ec_do_diff {
    echo "Diffing \`${EC_PACKAGES[*]}\`"
}

function ec_do_backup {
    echo "Backing up \`${EC_PACKAGES[*]}\`"
}

ec_log_note "Running env-config v4..."

ec_print_cli_args
ec_print_context
ec_log_debug "################################################################################"

case "$EC_COMMAND" in
    install)
        EC_COMMAND_FUNCTION=ec_do_install;;
    remove)
        EC_COMMAND_FUNCTION=ec_do_remove;;
    diff)
        EC_COMMAND_FUNCTION=ec_do_diff;;
    backup)
        EC_COMMAND_FUNCTION=ec_do_backup;;
    "")
        ec_log_error "Missing command"; exit 1;;
    *)
        ec_log_error "Unsupported command \`$EC_COMMAND\`"; exit 1;;
esac
readonly EC_COMMAND_FUNCTION

declare EC_LAYER_DIR="${EC_ENABLED_LAYERS[0]}"

ec_validate_layers "${EC_ENABLED_LAYERS[@]}" || exit 1

EC_DISTRO="$(which-distro)"
readonly EC_DISTRO

EC_PLATFORM="$(which-platform)"
readonly EC_PLATFORM

ec_source_distro_and_platform || exit 1

if [[ ! -v EC_TARGET_PACKAGES ]]; then
    EC_TARGET_PACKAGES=("${all[@]}")
fi

ec_source_recipes_recursively 
ec_compute_dependency_chain

# Execute the user provided command
$EC_COMMAND_FUNCTION
