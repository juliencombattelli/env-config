#!/usr/bin/env bash

# Ensure the script is executed or sourced with Bash
if [[ ! -v BASH_VERSINFO ]] || (( BASH_VERSINFO[0] < 4 )); then
    echo "Bash 4+ is required ro tun env-config"
    # Use return if possible to avoid exiting on sourcing
    if (return 0 2>/dev/null); then
        return 1
    else
        exit 1
    fi
fi

################################################################################
### Global shell options
################################################################################

set -euo pipefail

shopt -s dotglob    # We want glob to match hidden files too
shopt -s globstar   # We want to match files recursively using **
shopt -s nullglob   # We want glob to return nothing of there is no match
shopt -s sourcepath # We want source to search for files in PATH

################################################################################
### Global context variables
################################################################################

function ec_root_dir {
    # From https://stackoverflow.com/a/246128
    local SOURCE_PATH="${BASH_SOURCE[0]}"
    local SYMLINK_DIR
    while [ -L "$SOURCE_PATH" ]; do
        SYMLINK_DIR="$( cd -P "$( dirname "$SOURCE_PATH" )" >/dev/null 2>&1 && pwd )"
        SOURCE_PATH="$(readlink "$SOURCE_PATH")"
        if [[ $SOURCE_PATH != /* ]]; then
            SOURCE_PATH=$SYMLINK_DIR/$SOURCE_PATH
        fi
    done
    (cd -P "$( dirname "$SOURCE_PATH" )" >/dev/null 2>&1 && pwd)
}

EC_ROOT_DIR="$(ec_root_dir)"
declare -rx EC_ROOT_DIR
declare -rx EC_BUILD_DIR="$EC_ROOT_DIR/build"
declare -rx EC_LOGS_DIR="$EC_BUILD_DIR/logs"
declare -rx EC_WORK_DIR="$EC_BUILD_DIR/work"
declare -rx EC_DOWNLOADS_DIR="$EC_BUILD_DIR/downloads"

declare -rx EC_LOG_FILE="$EC_LOGS_DIR/env-config.log"

export PATH="$EC_ROOT_DIR/libs:$EC_ROOT_DIR/files/scripts:$PATH"

# shellcheck source-path=lib
source ansi.bash
# shellcheck source-path=lib
source utils.bash
# shellcheck source-path=lib
source backtrace.bash
# shellcheck source-path=lib
source task_runner.bash

################################################################################
### Global variables
################################################################################

# Declared upfront for better linting in the functions below
# Some of them are marked readonly later-on after their proper initialization

# HTTP proxy configuration
EC_PROXY_SERVER=""
EC_PROXY_PORT=""
EC_PROXY_USER=""
EC_NO_PROXY=""

declare -rx EC_DISABLE_PKG_PROVIDERS_UPDATE=${EC_DISABLE_PKG_PROVIDERS_UPDATE:-}

# Detected distro
EC_DISTRO=
# Detected platform
EC_PLATFORM=
# Detected CPU architecture
EC_CPU_ARCH="$(uname --machine)"
# Whether to use colors
EC_COLOR=auto
# Maximum number of concurrent jobs (must be 1 at the moment)
EC_JOBS_COUNT=1
# Whether to skip installing dependencies
EC_SKIP_DEPENDENCIES=false
# List of all packages supported in the current environment, set from config/default.bash
declare -a EC_ALL_PKGS=()
# List of packages to operate on, set from command line arguments, defaults to EC_ALL_PKGS
EC_TARGET_PKGS=()
# List of package providers available on the current distro, set from distro files
EC_DISTRO_PKG_PROVIDERS=()

readonly EC_CPU_ARCH

################################################################################
### Core functions
################################################################################

declare -a EC_AT_EXIT_HANDLERS=()

function ec_at_exit {
    local -r ec_at_exit_status=$?
    if (( ec_at_exit_status != 0 )); then
        if [[ -n ${EC_BACKTRACE:-} ]] || [[ -z ${ec_normal_exit:-} ]]; then
            echo "Aborting (code $ec_at_exit_status)."
            backtrace
        fi
    fi
    for ((i=${#EC_AT_EXIT_HANDLERS[@]}-1; i>=0; i--)); do
        local handler="${EC_AT_EXIT_HANDLERS[i]}"
        ec_log D "Running at_exit handler: $handler"
        if ! eval "$handler"; then
            ec_log W "EXIT handler failed: $handler"
        fi
    done
}

function ec_detect_source_and_validate_distro {
    local -r distro_name=$(cat /etc/os-release | grep "^ID=" | cut -d'=' -f2)
    local -r distro_version=$(cat /etc/os-release | grep "^VERSION_ID=" | cut -d'=' -f2 | tr -d '".')
    local -r distro_file="config/distros/$distro_name.bash"
    ec_log D "Checking distro file '$distro_file'"
    if [[ ! -f $distro_file ]]; then
        ec_log E "Unsupported distro '$distro_name'"
        return 1
    fi
    if ! source "$distro_file" "$distro_version"; then
        ec_log E "Error while sourcing distro file '$distro_file'"
        return 1
    fi
    readonly EC_DISTRO="$distro_name"
}

function ec_detect_source_and_validate_platform {
    local -r platform_name="$(which-platform)"
    local -r platform_file="config/platforms/$platform_name.bash"
    ec_log D "Checking platform file '$platform_file'"
    if [[ ! -f $platform_file ]]; then
        ec_log E "Unsupported platform '$platform_name'"
        return 1
    fi
    if ! source "$platform_file"; then
        ec_log E "Error while sourcing platform file '$platform_file'"
        return 1
    fi
    readonly EC_PLATFORM="$platform_name"
}

function ec_source_distro_and_platform {
    local valid=true
    ec_detect_source_and_validate_distro || valid=false
    ec_detect_source_and_validate_platform || valid=false
    $valid
}

function ec_relink {
    local link="$1"
    local target="$2"
    if [[ ! -e "$target" ]]; then
        ec_log E "relink: target '$target' does not exist"
        return 1
    fi
    if [[ ! -h "$link" ]]; then
        ec_log E "relink: link '$link' already exist and is not a link"
        return 1
    fi
    ec_log N "Relinking '$link' -> '$target'"
    ln -sf "$target" "$link"
}

################################################################################
### Operations
################################################################################

function _ec_run_install {
    source config/default.bash

    ec_register_pkg_providers

    ec_source_distro_and_platform

    ec_print_env_summary

    ec_setup_pkg_providers

    ec_log N "Installing prerequisites"

    local pkgs=( "${EC_PREREQ_PKGS[@]}" )
    if ! ec_discover_tasks "${pkgs[@]}"; then
        ec_log E "Errors during task discovery, exiting."
        exit 1
    fi

    if (( ${#EC_TASK_RECIPES[@]} == 0 )); then
        ec_log E "No task found for packages: $(ec_join_affix ', ' \` \` "${pkgs[@]}")."
        exit 1
    fi

    # TODO check if this can be done during discovery
    ec_validate_dependencies

    ec_execute_tasks

    ec_log N "Installing packages"

    local pkgs=( "${EC_TARGET_PKGS[@]:-${EC_ALL_PKGS[@]}}" )
    if ! ec_discover_tasks "${pkgs[@]}"; then
        ec_log E "Errors during task discovery, exiting."
        exit 1
    fi

    if (( ${#EC_TASK_RECIPES[@]} == 0 )); then
        ec_log E "No task found for packages: $(ec_join_affix ', ' \` \` "${pkgs[@]}")."
        exit 1
    fi

    # TODO check if this can be done during discovery
    ec_validate_dependencies

    ec_execute_tasks
}

function _ec_run_remove {
    # Don't use EC_ALL_PKGS if EC_TARGET_PKGS is empty as it would be too destructive
    ec_log N "Removing $(ec_join_affix ', ' \` \` "${EC_TARGET_PKGS[@]}")..."
}


################################################################################
### Main execution
################################################################################

function ec_prepare_build_dir {
    mkdir -p "$EC_BUILD_DIR"
    mkdir -p "$EC_LOGS_DIR"
    mkdir -p "$EC_WORK_DIR"
    mkdir -p "$EC_DOWNLOADS_DIR"
}

function ec_help {
    cat << 'EOH'
Usage:
    env-config [OPTIONS] COMMAND

Commands:
    install [PKG...]        Install and configure packages
    remove  [PKG...]        Completely uninstall packages (package itself and its configuration)

Options:
    -h, --help              Display this message
    --color WHEN            Control when to use color in output (auto, never or always)
    --no-deps               Skip installing dependencies (useful for reinstalling/reconfiguring)
    --proxy-server URL      Proxy server URL
    --proxy-port   PORT     Proxy port number (requires --proxy-server)
    --proxy-user   USER     Proxy user (requires --proxy-server)
    --no-proxy     URL,...  URLs not served by the proxy (requires --proxy-server)

The arguments `PKG` must be the basename of one of the recipes available
(ie. the recipe file `recipes/zsh.bash` provides the package `zsh`).

If `all` is provided as package env-config will install and configure all applicable packages
for the current distribution and platform.

If no package is provided `all` is used as default.
EOH
}

function ec_parse_args {
    local positional_args
    while (( $# > 0 )); do
        if [[ "$1" == -*=* ]]; then
            local opt="${1%%=*}"
            local val="${1#*=}"
            shift
            set -- "$opt" "$val" "$@"
        fi

        case "$1" in
            -h|--help)
                ec_help; exit 0;;
            --color)
                case "${2:-}" in
                    auto) EC_COLOR=auto; shift 2;;
                    never) EC_COLOR=false; shift 2;;
                    always) EC_COLOR=true; shift 2;;
                    '') ec_log E "Missing value for option --color"; exit 1;;
                    *) ec_log E "Invalid value \`$2\` for option --color, possible values: auto, never, always"; exit 1;;
                esac;;
            --no-deps)
                EC_SKIP_DEPENDENCIES=true; shift 1;;
            --proxy-server)
                EC_PROXY_SERVER="$2"; shift 2;;
            --proxy-port)
                EC_PROXY_PORT="$2"; shift 2;;
            --proxy-user)
                EC_PROXY_USER="$2"; shift 2;;
            --no-proxy)
                EC_NO_PROXY="$2"; shift 2;;
            -*)
                ec_log E "Unknown option \`$1\`"; exit 1;;
            *)
                positional_args+=("$1"); shift;;
        esac
    done

    readonly EC_PROXY_SERVER
    readonly EC_PROXY_PORT
    readonly EC_PROXY_USER
    readonly EC_NO_PROXY
    readonly EC_SKIP_DEPENDENCIES

    if [[ "$EC_COLOR" == auto ]]; then
        EC_COLOR=true
        if [[ -n "${NO_COLOR:-}" ]]; then
            EC_COLOR=false
        elif [[ "${TERM:-dump}" == "dumb" ]]; then
            EC_COLOR=false
        elif [[ ! -t 1 ]]; then
            EC_COLOR=false
        fi
    fi
    readonly EC_COLOR
    declare -rx EC_LOG_COLOR="$EC_COLOR"

    readonly EC_COMMAND="${positional_args[0]:-}"
    case "$EC_COMMAND" in
        install)
            EC_COMMAND_FUNCTION=_ec_run_install;;
        remove)
            EC_COMMAND_FUNCTION=_ec_run_remove;;
        '')
            ec_log E "Missing command"; exit 1;;
        *)
            ec_log E "Unsupported command \`$EC_COMMAND\`"; exit 1;;
    esac
    readonly EC_COMMAND_FUNCTION

    EC_TARGET_PKGS=("${positional_args[@]:1}")
    readonly EC_TARGET_PKGS
}

function ec_print_env_summary {
    ec_log N@stdout ""
    ec_log N "Current environment configuration:"
    ec_log N "EC_VERSION    = \"\""
    ec_log N "EC_DISTRO     = \"$EC_DISTRO\""
    ec_log N "EC_PLATFORM   = \"$EC_PLATFORM\""
    ec_log N "EC_CPU_ARCH   = \"$EC_CPU_ARCH\""
    ec_log N@stdout ""
}

function ec_register_pkg_providers {
    local provider_file provider
    for provider_file in pkg_providers/*.bash; do
        provider=$(basename --suffix=.bash "$provider_file")
        if [[ ! "$provider" =~ ^[a-zA-Z_][a-zA-Z_0-9]*$ ]]; then
            ec_log E "Provider '$provider' is not a valid Bash identifier"
            exit 1
        fi
        ec_log D "Registering pkg provider '$provider'"
        declare -gA EC_PKG_PROVIDER_${provider}_PKG_PATTERN
    done
}

function ec_setup_pkg_providers {
    local provider
    for provider in "${EC_DISTRO_PKG_PROVIDERS[@]}"; do
        ec_log D "Setting up pkg provider '$provider'"
        source pkg_providers/$provider.bash
        if [[ $(type -t "ec_${provider}_setup") == function ]]; then
            ( set -x; "ec_${provider}_setup" )
        fi
    done
}

function main {
    trap ec_at_exit EXIT

    ec_prepare_build_dir

    ec_parse_args "$@"

    $EC_COMMAND_FUNCTION

    # source recipes/bat.bash
