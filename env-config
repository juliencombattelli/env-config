#!/usr/bin/env bash

################################################################################
### Global shell options
################################################################################

set -euo pipefail

shopt -s dotglob    # We want glob to match hidden files too
shopt -s globstar   # We want to match files recursively using **
shopt -s nullglob   # We want glob to return nothing of there is no match
shopt -s sourcepath # We want source to search for files in PATH

################################################################################
### Global context variables
################################################################################

function ec_root_dir {
    # From https://stackoverflow.com/a/246128
    local SOURCE_PATH="${BASH_SOURCE[0]}"
    local SYMLINK_DIR
    while [ -L "$SOURCE_PATH" ]; do
        SYMLINK_DIR="$( cd -P "$( dirname "$SOURCE_PATH" )" >/dev/null 2>&1 && pwd )"
        SOURCE_PATH="$(readlink "$SOURCE_PATH")"
        if [[ $SOURCE_PATH != /* ]]; then
            SOURCE_PATH=$SYMLINK_DIR/$SOURCE_PATH
        fi
    done
    (cd -P "$( dirname "$SOURCE_PATH" )" >/dev/null 2>&1 && pwd)
}

EC_ROOT_DIR="$(ec_root_dir)"
readonly EC_ROOT_DIR
readonly EC_LAYER_CORE_DIR="$EC_ROOT_DIR/layer-core"
readonly EC_BUILD_DIR="$EC_ROOT_DIR/build"

export PATH="$EC_ROOT_DIR/lib:$PATH"

# shellcheck source-path=lib
source ansi.bash
# shellcheck source-path=lib
source log.bash
# shellcheck source-path=lib
source utils.bash
# shellcheck source-path=lib
source progress.bash

################################################################################
### Global variables
################################################################################

# Declared upfront for better linting in the functions below
# Some of them are marked readonly later-on after their proper initialization

# HTTP proxy configuration
EC_PROXY_SERVER=""
EC_PROXY_PORT=""
EC_PROXY_USER=""
EC_NO_PROXY=""

# Path to enabled layers
EC_ENABLED_LAYERS=("$EC_LAYER_CORE_DIR")
# Path of the currently parsed recipe, distro or platform file
EC_LAYER_DIR="${EC_ENABLED_LAYERS[0]}"
export EC_LAYER_DIR # used by recipes
# Number of tasks running concurrently
EC_JOBS_COUNT=1
# Whether to use colors
EC_COLOR=auto
# Whether to skip installing dependencies
EC_SKIP_DEPENDENCIES=false
# List of packages to operate on
EC_TARGET_PACKAGES=()

# TODO remove those debug features
EC_DEBUG_SLEEP=false

# Handlers executed at exit on reverse registration order
EC_AT_EXIT_HANDLERS=()

function ec_at_exit {
    for ((i=${#EC_AT_EXIT_HANDLERS[@]}-1; i>=0; i--)); do
        local handler="${EC_AT_EXIT_HANDLERS[i]}"
        ec_log_debug "Running at_exit handler \`$handler\`"
        eval "$handler"
    done
}

function ec_initialize_at_exit_handler {
    EC_AT_EXIT_HANDLERS=()
    trap ec_at_exit EXIT
}

function ec_into_layer_path {
    # Make a path relative to the englobing layer. Return 1 if not in an enabled layer.
    # The path printed into stdout as the form //<layer-name>/<subpath>
    local path="$1"
    local layer_path
    for layer_path in "${EC_ENABLED_LAYERS[@]}"; do
        if [[ "$path" == "$layer_path"/* ]]; then
            local parent_dir
            parent_dir="$(dirname "$layer_path")"
            local subpath="${path#"^$parent_dir"}"
            echo "/$subpath"
            return 0
        fi
    done
    ec_log_error "Path \`$path\` is not in an enabled layer."
    return 1
}

################################################################################
### Core functions
################################################################################

function ec_validate_layers {
    local invalid_layer=false
    local layer_dir
    for layer_dir in "$@"; do
        if [[ ! -d "$layer_dir" ]]; then
            ec_log_error "Layer directory \`$layer_dir\` does not exist."
            invalid_layer=true
        elif [[ ! -f "$layer_dir/layer.bash" ]]; then
            ec_log_error "Layer file \`$layer_dir/layer.bash\` does not exist."
            invalid_layer=true
        fi
    done
    if $invalid_layer; then
        return 1
    fi
}

function ec_source_and_validate_distro {
    local valid=false
    local layer_path
    for layer_path in "${EC_ENABLED_LAYERS[@]}"; do
        local distro_file="$layer_path/distros/$EC_DISTRO.bash"
        ec_log_debug "Checking distro file $distro_file"
        if [[ -f $distro_file ]]; then
            EC_LAYER_DIR="$layer_path"
            # shellcheck disable=SC1090
            source "$distro_file" || valid=false
            # TODO add validation
            valid=true
        fi
    done
    if ! $valid; then
        ec_log_error "Unsupported distro \`$EC_DISTRO\`"
        return 1
    fi
}

function ec_source_and_validate_platform {
    local valid=false
    local layer_path
    for layer_path in "${EC_ENABLED_LAYERS[@]}"; do
        local platform_file="$layer_path/platforms/$EC_PLATFORM.bash"
        ec_log_debug "Checking platform file $platform_file"
        if [[ -f $platform_file ]]; then
            EC_LAYER_DIR="$layer_path"
            # shellcheck disable=SC1090
            source "$platform_file" || valid=false
            # TODO add validation
            valid=true
        fi
    done
    if ! $valid; then
        ec_log_error "Unsupported platform \`$EC_PLATFORM\`"
        return 1
    fi
}

function ec_source_distro_and_platform {
    local valid=true
    ec_source_and_validate_distro || valid=false
    ec_source_and_validate_platform || valid=false
    $valid
}

function ec_get_recipe_file_for_package {
    local package="$1"
    local -a recipe_file=()
    local layer_path
    for layer_path in "${EC_ENABLED_LAYERS[@]}"; do
        shopt -s nullglob
        recipe_file+=("$layer_path"/recipes/*/"$package".bash)
    done
    if (( ${#recipe_file[@]} > 1 )); then
        ec_log_error "Found more than one recipe for package \`$package\` (total ${#recipe_file[@]}):"
        ec_log_error "${recipe_file[@]}"
        return 1
    elif (( ${#recipe_file[@]} == 0 )); then
        ec_log_error "No recipe found for package \`$package\`."
        return 1
    fi
    echo "${recipe_file[@]}"
}

# Associative arrays to store task information
declare -A EC_TASK_DEPENDENCIES=() # task -> space-separated list of dependencies
declare -A EC_TASK_RECIPES=()      # task -> path to task script
declare -A EC_TASK_COMPLETED=()    # task -> exit status (0 on success, non-zero on failure)
declare -A EC_TASK_RUNNING=()      # task -> PID if running
declare -A EC_TASK_TIMER=()        # task -> duration time points

function ec_wait_background_processes {
    local remaining=${#EC_TASK_RUNNING[@]}
    while (( remaining > 0 )); do
        ec_log_note "Waiting for $remaining background process(es) to complete..."
        # Ignore the tasks exit status as we just want them to finish
        wait -n -p awaited_pid 2>/dev/null || true
        if [[ -v awaited_pid ]]; then
            local task
            for task in "${!EC_TASK_RUNNING[@]}"; do
                if (( EC_TASK_RUNNING[$task] == awaited_pid )); then
                    unset "EC_TASK_RUNNING[$task]"
                    break
                fi
            done
        fi
        remaining=$((remaining - 1))
    done
}

function ec_kill_background_processes {
    local -a background_jobs
    readarray -t background_jobs < <(jobs -p)
    if (( ${#background_jobs[@]} > 0 )); then
        ec_log_warn "Killing all background jobs" >&2
        kill "${background_jobs[@]}" >&2
        EC_TASK_RUNNING=()
    fi
}

function ec_discover_task {
    local task_name="$1"
    local layer_dir="$2"
    local chain="${3-}"

    # Detect circular dependency: task_name is already an ancestor in the
    # current discovery chain. Bail out immediately, before any task runs.
    local -a chain_array=($chain)
    local i
    for ((i = 0; i < ${#chain_array[@]}; i++)); do
        if [[ "${chain_array[$i]}" == "$task_name" ]]; then
            ec_log_error "Circular dependency detected: $(ec_join_affix ' -> ' \` \` "${chain_array[@]:i}" "$task_name")"
            exit 1
        fi
    done

    # Skip if already discovered
    [[ -v EC_TASK_RECIPES[$task_name] ]] && return 0

    # Find the task file
    local task_file
    task_file="$(ec_get_recipe_file_for_package "$task_name")" || return 1

    ec_log_debug "  Discovering task: $task_name from $task_file"

    # Store the script path
    EC_TASK_RECIPES["$task_name"]="$task_file"

    # Source the file in a subshell to extract DEPENDS array
    local deps
    deps=$(
        DEPENDS=()
        # TODO handle error when sourcing the recipes
        # shellcheck disable=SC1090
        source "$task_file" 2>/dev/null || true
        echo "${DEPENDS[*]}"
    )

    # Store dependencies (unless --no-deps is set)
    if $EC_SKIP_DEPENDENCIES; then
        EC_TASK_DEPENDENCIES["$task_name"]=""
        ec_log_debug "    Dependencies: ${deps:-none} (skipped)"
    else
        EC_TASK_DEPENDENCIES["$task_name"]="$deps"
        ec_log_debug "    Dependencies: ${deps:-none}"

        # Recursively discover dependencies, extending the chain so any
        # cycle further down can be detected against the full ancestry
        local dep
        for dep in $deps; do
            ec_discover_task "$dep" "$layer_dir" "$chain $task_name"
        done
    fi
}

function ec_discover_tasks {
    local layer_dir="$1"
    shift
    local -a target_packages=("$@")

    ec_log_debug "Discovering tasks in $layer_dir for packages $(ec_join_affix ', ' \` \` "${target_packages[@]}")..."

    EC_LAYER_DIR="$layer_dir"

    # Discover each target package and its dependencies
    local package
    for package in "${target_packages[@]}"; do
        ec_discover_task "$package" "$layer_dir" || continue
    done
}

# Check if all dependencies of a task are completed
function ec_dependencies_satisfied {
    local task="$1"
    local deps="${EC_TASK_DEPENDENCIES[$task]}"

    # No dependencies means ready to run
    [[ -z "$deps" ]] && return 0

    # Check each dependency
    local dep
    for dep in $deps; do
        if [[ ! -v EC_TASK_COMPLETED[$dep] ]]; then
            return 1 # Dependency not completed
        elif (( EC_TASK_COMPLETED[$dep] != 0 )); then
            return 1 # Dependency failed
        fi
    done

    return 0 # All dependencies completed
}

# Execute a task in the background
function _ec_execute_task {
    local task="$1"
    local script="${EC_TASK_RECIPES[$task]}"

    (
        # Ignore interrupt signals so task continues even when parent is interrupted
        trap '' SIGINT

        # Source the task script and call do_install
        DEPENDS=()
        # shellcheck disable=SC1090
        source "$script"

        bash ./tests/layer-random/recipes/random/random.bash &>/dev/null # |& tee "$FIFO" &>"$LOGFILE"
    ) &

    # Store the PID
    EC_TASK_RUNNING["$task"]=$!
}

# Report tasks that can't start because dependencies are unmet or failed
function _ec_report_blocked_tasks {
    local -a blocked_lines=()
    local -a stuck_lines=()
    local task
    for task in "${!EC_TASK_RECIPES[@]}"; do
        [[ -v EC_TASK_COMPLETED[$task] ]] && continue

        local deps="${EC_TASK_DEPENDENCIES[$task]}"
        local -a unmet_deps=()
        local dep
        for dep in $deps; do
            if [[ -v EC_TASK_COMPLETED[$dep] ]]; then
                (( EC_TASK_COMPLETED[$dep] != 0 )) && unmet_deps+=("$dep")
            else
                unmet_deps+=("$dep")
            fi
        done

        if (( ${#unmet_deps[@]} > 0 )); then
            blocked_lines+=("  - \`$task\` cannot run because dependencies did not complete: $(ec_join_affix ', ' \` \` "${unmet_deps[@]}")")
        else
            stuck_lines+=("  - \`$task\` (depends on: $(ec_join_affix ', ' \` \` ${deps:-none}))")
        fi
    done

    if (( ${#blocked_lines[@]} > 0 )); then
        ec_log_error "Some tasks cannot run because one or more dependencies did not complete:"
        local line
        for line in "${blocked_lines[@]}"; do
            ec_log_error "$line"
        done
    fi

    if (( ${#stuck_lines[@]} > 0 )); then
        ec_log_error "No tasks can be started, but none of their dependencies failed. This should not happen and is likely a bug in the task scheduler:"
        local line
        for line in "${stuck_lines[@]}"; do
            ec_log_error "$line"
        done
    fi
}

readonly EC_TASK_EXECUTION_PROGRESS_RENDERING_FIFO=progress_rendering_event_pipe
EC_TASK_EXECUTION_PROGRESS_RENDERING_FD=
EC_TASK_EXECUTION_PROGRESS_RENDERING_PID=

function ec_render_tasks_execution_progress {
    ec_initialize_at_exit_handler

    EC_AT_EXIT_HANDLERS+=(ec_progress_deinit_term)
    ec_progress_init_term

    timer_reset GLOBAL_TIMER

    function ec_render_tasks_execution_progress_loop {
        local event_count=0
        while IFS='|' read -r type payload; do
            event_count=$(( event_count + 1 ))
            case "$type" in
                "task_started")
                    local task=$payload
                    ec_log_note "Starting: $payload"
                    ;;
                "task_completed")
                    IFS='|' read -r task pid time status <<< "$payload"
                    if (( status == 0 )); then
                        ec_log_note "Task \`$task\` (PID: $pid) succeeded in $time."
                    else
                        ec_log_error "Task \`$task\` (PID: $pid) failed after $time!"
                    fi
                    ;;
                "shutdown")
                    ec_log_note "Renderer shutting down after $event_count events"
                    return
                    ;;
            esac
        done < "$EC_TASK_EXECUTION_PROGRESS_RENDERING_FIFO"
        ec_log_warn "ec_render_tasks_execution_progress received EOF"
    }
    ec_render_tasks_execution_progress_loop

    ec_log_note "Execution terminated in $(timer_elapsed GLOBAL_TIMER)."
}

function ec_create_task_execution_rendering_process {
    EC_AT_EXIT_HANDLERS+=('rm -f "$EC_TASK_EXECUTION_PROGRESS_RENDERING_FIFO"')
    # TODO create fifo into build directory
    mkfifo $EC_TASK_EXECUTION_PROGRESS_RENDERING_FIFO 2>/dev/null || true

    ec_render_tasks_execution_progress &
    EC_TASK_EXECUTION_PROGRESS_RENDERING_PID=$!
    readonly EC_TASK_EXECUTION_PROGRESS_RENDERING_PID

    # Keep a persistent writer fd open on the FIFO for the whole duration of this
    # function. Without this, every write into the fifo independently opens and
    # then closes the FIFO for writing. Since the reader keeps its read end open
    # across the whole loop, the moment a writer closes and no other writer is
    # currently open, the reader's `read` gets EOF and its `while` loop exits
    # (without ever seeing the "shutdown" event). Any later write then blocks
    # forever trying to open the FIFO, since there is no reader left to pair with.
    exec {EC_TASK_EXECUTION_PROGRESS_RENDERING_FD}> "$EC_TASK_EXECUTION_PROGRESS_RENDERING_FIFO"
    readonly EC_TASK_EXECUTION_PROGRESS_RENDERING_FD
}

function ec_terminate_task_execution_rendering_process {
    ec_post_rendering_event shutdown
    exec {EC_TASK_EXECUTION_PROGRESS_RENDERING_FD}>&-
    wait "$EC_TASK_EXECUTION_PROGRESS_RENDERING_PID"
}

function ec_post_rendering_event {
    local event="$1"
    local payload="${2:-}"
    echo "$event|$payload" > "$EC_TASK_EXECUTION_PROGRESS_RENDERING_FIFO"
}

# Main execution loop with dynamic dependency resolution
function ec_execute_tasks {
    ec_log_note "Executing tasks..."

    EC_AT_EXIT_HANDLERS+=(ec_wait_background_processes)

    ec_create_task_execution_rendering_process

    local total_tasks=${#EC_TASK_RECIPES[@]}
    local completed_count=0
    local blocked=false
    local task

    # Reverse mapping: PID -> task name
    declare -A pid_to_task=()

    while (( completed_count < total_tasks )); do
        # Start all tasks whose dependencies are satisfied
        local tasks_started=false
        for task in "${!EC_TASK_RECIPES[@]}"; do
            # Skip if already completed (successfully or not) or running
            [[ -v EC_TASK_COMPLETED[$task] ]] && continue
            [[ -v EC_TASK_RUNNING[$task] ]] && continue
            (( ${#EC_TASK_RUNNING[@]} >= EC_JOBS_COUNT )) && continue

            # Check if dependencies are satisfied
            if ec_dependencies_satisfied "$task"; then
                ec_post_rendering_event task_started "$task"
                timer_reset EC_TASK_TIMER["$task"]
                _ec_execute_task "$task"
                pid_to_task["${EC_TASK_RUNNING[$task]}"]="$task"
                tasks_started=true
            fi
        done

        # If no tasks are running and none could start, we have a problem
        local running_count=${#EC_TASK_RUNNING[@]}
        if (( running_count == 0 )); then
            if ! $tasks_started; then
                blocked=true
                break
            fi
            continue
        fi

        # Wait for any single task to complete
        local completed_pid
        local task_status=0
        # || is important here as errexit option is set
        wait -n -p completed_pid "${EC_TASK_RUNNING[@]}" || task_status=$?
        if [[ -v pid_to_task[$completed_pid] ]]; then
            local completed_task="${pid_to_task[$completed_pid]}"
            local elapsed_time
            elapsed_time=$(timer_elapsed EC_TASK_TIMER["$completed_task"])
            EC_TASK_COMPLETED["$completed_task"]=$task_status
            unset "EC_TASK_RUNNING[$completed_task]"
            unset "pid_to_task[$completed_pid]"
            completed_count=$((completed_count + 1))
            ec_post_rendering_event task_completed "$completed_task|$completed_pid|$elapsed_time|$task_status"
        fi

        # Loop continues immediately to check for newly ready tasks
    done

    local -a failed_tasks=()
    for task in "${!EC_TASK_COMPLETED[@]}"; do
        (( EC_TASK_COMPLETED[$task] != 0 )) && failed_tasks+=("$task")
    done
    if (( ${#failed_tasks[@]} > 0 )); then
        ec_log_error "Some tasks failed: $(ec_join_affix ', ' \` \` "${failed_tasks[@]}")."
    fi

    if $blocked; then
        _ec_report_blocked_tasks
    fi

    ec_terminate_task_execution_rendering_process

    if $blocked || (( ${#failed_tasks[@]} > 0 )); then
        exit 1
    fi

    ec_log_note "All tasks completed successfully!"
}

# Validate that all dependencies exist
function ec_validate_dependencies {
    local validation_failed=0

    local task
    for task in "${!EC_TASK_DEPENDENCIES[@]}"; do
        local deps="${EC_TASK_DEPENDENCIES[$task]}"

        local dep
        for dep in $deps; do
            if [[ ! -v EC_TASK_RECIPES[$dep] ]]; then
                ec_log_error "Task \`$task\` depends on \`$dep\`, but \`$dep\` could not be found!"
                validation_failed=1
            fi
        done
    done

    if (( validation_failed == 1 )); then
        exit 1
    fi
}

################################################################################
### Operations
################################################################################

function ec_do_install {
    local layer_dir
    for layer_dir in "${EC_ENABLED_LAYERS[@]}"; do
        ec_discover_tasks "$layer_dir" "${EC_TARGET_PACKAGES[@]}"
    done

    if (( ${#EC_TASK_RECIPES[@]} == 0 )); then
        ec_log_error "No task found for packages: $(ec_join_affix ', ' \` \` "${EC_TARGET_PACKAGES[@]}")."
        exit 1
    fi

    ec_validate_dependencies
    ec_execute_tasks
}

function ec_do_remove {
    ec_log_note "Removing $(ec_join_affix ', ' \` \` "${EC_TARGET_PACKAGES[@]}")..."
}

function ec_do_diff {
    ec_log_note "Diffing $(ec_join_affix ', ' \` \` "${EC_TARGET_PACKAGES[@]}")..."
}

function ec_do_backup {
    ec_log_note "Backing up $(ec_join_affix ', ' \` \` "${EC_TARGET_PACKAGES[@]}")..."
}

