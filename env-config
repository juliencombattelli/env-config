set -euo pipefail

function relink {
    local link="$1"
    local target="$2"

    if [[ ! -e "$target" ]]; then
        echo "relink: target '$target' does not exist"
        return 1
    fi

    if [[ ! -h "$link" ]]; then
        echo "relink: link '$link' already exist and is not a link"
        return 1
    fi

    echo "Relinking '$link' -> '$target'"
    ln -sf "$target" "$link"
}
